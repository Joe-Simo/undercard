# Qloo hackathon key (request via the form in the Qloo hackathon developer guide). Base URL is hackathon.api.qloo.com.
QLOO_API_KEY=
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM for rationales, copy, and the follow-up chat. All free tiers, no credit card. The first one set wins.
# OpenRouter: free models only (ids ending in ":free"). Default nvidia/nemotron-3-ultra-550b-a55b:free,
# with fallbacks from UNDERCARD_FALLBACK_MODELS. Free accounts get 50 requests a day; responses are cached.
OPENROUTER_API_KEY=
# UNDERCARD_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Groq: sign in at console.groq.com (GitHub works), create an API key. Default model openai/gpt-oss-120b.
GROQ_API_KEY=
# GitHub Models: fine-grained personal access token with the "Models: read" permission. Default model openai/gpt-4.1-mini.
GITHUB_MODELS_TOKEN=
# Google AI Studio key. Default model gemini-2.5-flash.
GEMINI_API_KEY=
# UNDERCARD_MODEL=openai/gpt-oss-120b
